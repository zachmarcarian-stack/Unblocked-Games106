    "title": "Quick Click",
    "category": "Arcade",
    "description": "Click the target as many times as you can in 15 seconds.",
    "emoji": "⚡",
    "color": "#254b5b",
    "srcdoc": "<!doctype html><html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{margin:0;background:#101827;color:white;font-family:system-ui;text-align:center;display:grid;place-items:center;min-height:100vh}.wrap{padding:20px}.target{width:120px;height:120px;border:0;border-radius:50%;background:#43d6c5;font-size:48px;cursor:pointer;box-shadow:0 8px 0 #187c78}.target:active{transform:translateY(5px);box-shadow:0 3px 0 #187c78}button.start{padding:10px 20px;border:0;border-radius:8px;background:#7c6cff;color:white;font-weight:bold;cursor:pointer}</style></head><body><div class=\"wrap\"><h1>⚡ Quick Click</h1><h2>Time: <span id=\"time\">15</span>s · Score: <span id=\"score\">0</span></h2><button class=\"target\" id=\"target\" disabled>★</button><p id=\"message\">Press Start, then click fast!</p><button class=\"start\" id=\"start\">Start game</button></div><script>let score=0,time=15,timer;const target=document.getElementById('target');document.getElementById('start').onclick=()=>{clearInterval(timer);score=0;time=15;target.disabled=false;document.getElementById('score').textContent=0;document.getElementById('time').textContent=15;document.getElementById('message').textContent='Go!';timer=setInterval(()=>{time--;document.getElementById('time').textContent=time;if(time<=0){clearInterval(timer);target.disabled=true;document.getElementById('message').textContent='Time is up! Final score: '+score}},1000)};target.onclick=()=>{score++;document.getElementById('score').textContent=score}</script></body></html>"
