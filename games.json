    "description": "A tiny basketball shooting game. Click the ball to score.",
    "emoji": "🏀",
    "color": "#3b285d",
    "srcdoc": "<!doctype html><html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:linear-gradient(135deg,#17213a,#39245b);font-family:system-ui;color:white;text-align:center}.game{padding:24px}.hoop{font-size:100px}.ball{font-size:58px;border:0;background:none;cursor:pointer;transition:transform .15s}.ball:active{transform:translateY(-28px) scale(.9)}button.reset{padding:10px 18px;border:0;border-radius:9px;background:#7c6cff;color:white;font-weight:bold;cursor:pointer}</style></head><body><div class=\"game\"><h1>🏀 Hoop Shot</h1><div class=\"hoop\">🧺</div><button class=\"ball\" id=\"ball\" aria-label=\"Shoot basketball\">🏀</button><h2>Score: <span id=\"score\">0</span></h2><p>Tap the basketball to shoot!</p><button class=\"reset\" onclick=\"document.getElementById('score').textContent='0'\">Reset score</button></div><script>let score=0;document.getElementById('ball').onclick=()=>{score++;document.getElementById('score').textContent=score}</script></body></html>"
