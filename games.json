    "category": "Puzzle",
    "description": "Find all matching pairs of emoji cards.",
    "emoji": "🧠",
    "color": "#55402b",
    "srcdoc": "<!doctype html><html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{margin:0;background:#172033;color:white;font-family:system-ui;text-align:center;padding:18px}.board{display:grid;grid-template-columns:repeat(4, minmax(48px,72px));gap:9px;justify-content:center;margin:22px auto}.card{height:70px;border:0;border-radius:10px;background:#6558c9;color:white;font-size:28px;cursor:pointer}.card.open{background:#e7eaff;color:#182039}.card:disabled{cursor:default}.note{color:#aebbd0}</style></head><body><h1>🧠 Memory Match</h1><p class=\"note\">Flip cards and find all four pairs.</p><h3 id=\"status\">Moves: 0</h3><div class=\"board\" id=\"board\"></div><button onclick=\"start()\" style=\"padding:9px 16px;border:0;border-radius:8px\">Restart</button><script>const icons=['🍉','🚀','🐸','⭐'];let deck,moves,chosen,locked,matched;function start(){deck=[...icons,...icons].sort(()=>Math.random()-.5);moves=0;chosen=[];locked=false;matched=0;document.getElementById('status').textContent='Moves: 0';const b=document.getElementById('board');b.innerHTML='';deck.forEach((v,i)=>{let x=document.createElement('button');x.className='card';x.textContent='?';x.onclick=()=>flip(i,x);b.append(x)})}function flip(i,el){if(locked||el.classList.contains('open')||el.disabled)return;el.textContent=deck[i];el.classList.add('open');chosen.push({i,el});if(chosen.length===2){moves++;document.getElementById('status').textContent='Moves: '+moves;let [a,b]=chosen;if(deck[a.i]===deck[b.i]){a.el.disabled=b.el.disabled=true;matched+=2;chosen=[];if(matched===8)document.getElementById('status').textContent='You won in '+moves+' moves!'}else{locked=true;setTimeout(()=>{a.el.textContent=b.el.textContent='?';a.el.classList.remove('open');b.el.classList.remove('open');chosen=[];locked=false},750)}}}start()</script></body></html>"
  }
